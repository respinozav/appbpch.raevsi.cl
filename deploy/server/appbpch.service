[Unit]
Description=FastAPI Backend Service - appbpch.raevsi.cl
After=network.target

[Service]
Type=simple
User=ubuntu
Group=www-data
WorkingDirectory=/var/www/appbpch.raevsi.cl/backend
Environment="PATH=/var/www/appbpch.raevsi.cl/backend/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
Environment="PYTHONPATH=/var/www/appbpch.raevsi.cl/backend"
EnvironmentFile=-/var/www/appbpch.raevsi.cl/backend/.env
ExecStart=/var/www/appbpch.raevsi.cl/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001 --workers 2 --proxy-headers
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
